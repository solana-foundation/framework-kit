			"fast-xml-parser@<5.7.0": "^5.7.0",
			"fflate@>=0.7.0 <0.7.5": "^0.7.5",
			"glob@>=10.2.0 <10.5.0": ">=10.5.0",
			"image-size@>=0.6.3 <2.0.3": "^2.0.3",
			"js-yaml@<3.15.2": "^3.15.2",
			"js-yaml@>=4.0.0 <4.3.2": "^4.3.2",
			"minimatch@<3.1.4": "^3.1.4",
			"nanoid@<3.3.18": "^3.3.18",
			"path-to-regexp@>=8.0.0 <8.4.0": "^8.4.0",
			"picomatch@<2.3.2": "^2.3.2",
			"picomatch@>=4.0.0 <4.0.4": "^4.0.4",
			"postcss-selector-parser@>=7.1.0 <7.1.3": "^7.1.3",
			"postcss@<8.5.23": "^8.5.23",
			"rollup@>=4.0.0 <4.59.0": "^4.59.0",
			"sharp@<0.35.4": "^0.35.4",
			"shell-quote@<1.9.0": "^1.9.0",
			"uuid@<11.1.1": "^11.1.1",
			"vite@>=7.0.0 <7.3.5": "^7.3.5",
			"ws@>=7.0.0 <7.5.11": "^7.5.11",
			"ws@>=8.0.0 <8.21.0": "^8.21.0",
			"yaml@>=2.0.0 <2.8.3": "^2.8.3"
		}
	},
	"scripts": {
		"dev": "turbo run dev --parallel",
		"dev:react": "pnpm --filter @solana/example-vite-react dev",
		"build": "turbo run build",
		"format": "turbo run format",
		"lint": "turbo run lint",
		"test": "turbo run test",
		"typecheck": "turbo run typecheck",
		"size": "pnpm build && size-limit",
		"prepare": "husky",
		"check:circular-deps": "turbo run check:circular-deps",
		"changeset": "changeset",
		"version:packages": "changeset version",
		"publish-packages": "changeset publish --filter @solana/client --filter @solana/react-hooks --filter @solana/web3-compat"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.3.4",
		"@changesets/changelog-github": "^0.5.1",
		"@changesets/cli": "^2.29.7",
		"@size-limit/preset-small-lib": "^12.0.0",
		"@solana/codecs-strings": "^6.0.1",
		"@testing-library/jest-dom": "^6.6.3",
		"@testing-library/react": "^16.1.0",
		"@testing-library/user-event": "^14.5.2",
		"@vitest/coverage-v8": "^4.0.7",
		"bs58": "^6.0.0",
		"husky": "^9.1.7",
		"jsdom": "^24.1.0",
		"size-limit": "^12.0.0",
		"tsup": "^8.5.0",
		"turbo": "^2.6.0",
		"typescript": "^5.6.3",
		"vitest": "^4.0.7"
	}
}
