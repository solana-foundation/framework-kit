{
	"name": "framework-kit",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"packageManager": "pnpm@10.20.0",
	"pnpm": {
		"overrides": {
			"@babel/core@<7.29.6": "^7.29.6",
			"baseline-browser-mapping@>=2.0.0 <2.11.0": "^2.11.0",
			"bn.js@>=5.0.0 <5.2.3": ">=5.2.3",
			"brace-expansion@<1.1.21": "^1.1.21",
			"browserslist@<4.28.7": "^4.28.7",
